+bool
+MemCtrl::fsuInspectPacket(PacketPtr pkt)
+{
+    const Addr page = pkt->getAddr() & ~Addr(0xFFF);
+    if (pkt->req->isInstFetch()) {
+        return fsuWrittenPages.count(page) != 0;
+    }
+    if (pkt->isWrite()) {
+        fsuWrittenPages.insert(page);
+    }
+    return false;
+}
+
+void
+MemCtrl::fsuHandleViolation(PacketPtr pkt)
+{
+    const Addr page = pkt->getAddr() & ~Addr(0xFFF);
+    DPRINTF(FSU, "[FSU-ALERT] W^X violation: IFetch addr %#x on written "
+            "page %#x\n", pkt->getAddr(), page);
+
+    ThreadContext *tc = nullptr;
+    if (pkt->req->hasContextId()) {
+        tc = system()->threads[pkt->req->contextId()];
+    } else if (system()->threads.size() > 0) {
+        tc = system()->threads[0];
+    }
+    if (tc) {
+        // Stand-in for the page-table walker; not meaningful in SE mode
+        DPRINTF(FSU, "[FSU-CR3] Cr3=%#x (ctx %d)\n",
+                tc->readMiscRegNoEffect(X86ISA::misc_reg::Cr3),
+                tc->contextId());
+    }
+
+    // Evacuation: functional read of the 4 KB page into a file
+    std::vector<uint8_t> buf(4096);
+    system()->physProxy.readBlob(page, buf.data(), buf.size());
+    simout.createSubdirectory("fsu_evidence");
+    std::string dir = simout.resolve("fsu_evidence");
+    std::string path = csprintf("%s/%#x.bin", dir, page);
+    FILE *f = fopen(path.c_str(), "wb");
+    if (f) {
+        fwrite(buf.data(), 1, buf.size(), f);
+        fclose(f);
+    }
+    DPRINTF(FSU, "[FSU-EVAC] page %#x (4096 B) written to %s\n", page,
+            path);
+
+    // Abstract stall: the request is never answered, so the CPU stays
+    // blocked. tc->suspend() is not used: TimingSimpleCPU asserts if it is
+    // called while the CPU waits on a response (seen in cached runs).
+    if (tc) {
+        DPRINTF(FSU, "[FSU-STALL] holding request, context %d stalled "
+                "(abstract stall)\n", tc->contextId());
+    }
+    exitSimLoop("FSU: W^X violation");
+}
